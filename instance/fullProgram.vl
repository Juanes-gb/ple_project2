defmodule Set
using List
defspace Element : Element end
defspace SuperSet : Element end
defspace Set : Element < SuperSet end
defoperator union : Set -> Set -> Set [associative id:∅] end
defoperator isIn : Element -> Set -> Bool end
defoperator implication : Bool -> Bool -> Bool end
defoperator negation : Bool -> Bool end
defoperator disjunction : Bool -> Bool -> Bool end
defvar p : Bool, q : Bool end
defrule (implication p q) -> (disjunction (negation p) q) end
defexpression (forall x in Element . (forall S in Set . (forall U in Set . x isIn (union S U)))) end
end
